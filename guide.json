    "deploy": {
      "type": "script",
      "steps": [
        "git clone https://github.com/songjianyang/xss-audit.git",
        "mkdir -p ~/.claude/skills && cp -r xss-audit ~/.claude/skills/xss-audit",
        "echo \"装好后在 agent 里输入 /xss-audit src/\""
      ],
      "stepsPs": [
        "git clone https://github.com/songjianyang/xss-audit.git",
        "New-Item -ItemType Directory -Force \"$HOME\\.claude\\skills\" | Out-Null; Copy-Item -Recurse -Force .\\xss-audit \"$HOME\\.claude\\skills\\xss-audit\"",
        "Write-Host \"装好后在 agent 里输入 /xss-audit src/\""
      ],
      "source": "https://github.com/songjianyang/xss-audit#installation"
    },
    "pitfalls": [
      "技能找不到：确认目录名与 skills 路径",
      "没有报告：检查当前目录是否可写",
      "误报多：按证据逐条复核，别直接改",
      "扫描太慢：先只传 `src/` 子目录",
      "漏掉后端：本技能只覆盖前端代码",
      "报告覆盖旧文件：会自动加时间戳，注意找最新"
    ]
  },
